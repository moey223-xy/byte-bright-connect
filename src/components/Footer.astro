---
import { Facebook, Linkedin, Mail, Phone } from "lucide-react";

const year = new Date().getFullYear();
---

<footer class="bg-[#1F1F1F] text-white py-16">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-8 mb-12">
      <!-- Company Info -->
      <div class="md:col-span-2">
        <div class="text-3xl font-bold mb-4">
          BigByte<span class="text-[#2978F2]">Tech</span>
        </div>
        <p class="text-gray-300 mb-6 max-w-md">
          Your trusted IT partner, providing comprehensive technology solutions for small businesses.
          Focus on growth while we handle your IT.
        </p>
        <div class="flex space-x-4">
          <a href="#" aria-label="LinkedIn" class="w-10 h-10 bg-[#2978F2] rounded-full flex items-center justify-center hover:bg-[#1F5FD4] transition-colors duration-300">
            <Linkedin className="h-5 w-5" />
          </a>
          <a href="#" aria-label="Facebook" class="w-10 h-10 bg-[#2978F2] rounded-full flex items-center justify-center hover:bg-[#1F5FD4] transition-colors duration-300">
            <Facebook className="h-5 w-5" />
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-xl font-semibold mb-6">Quick Links</h4>
        <ul class="space-y-3">
          <li><a href="/#services" class="text-gray-300 hover:text-[#2978F2] transition-colors">Services</a></li>
          <li><a href="/services/managed-it-support-brisbane/" class="text-gray-300 hover:text-[#2978F2] transition-colors">IT Support Brisbane</a></li>
          <li><a href="/services/it-support-gold-coast/" class="text-gray-300 hover:text-[#2978F2] transition-colors">IT Support Gold Coast</a></li>
          <li><a href="/#about" class="text-gray-300 hover:text-[#2978F2] transition-colors">About Us</a></li>
          <li><a href="/#contact" class="text-gray-300 hover:text-[#2978F2] transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-xl font-semibold mb-6">Resources</h4>
        <ul class="space-y-3">
          <li><a href="/guides/" class="text-gray-300 hover:text-[#2978F2] transition-colors">All Guides</a></li>
          <li><a href="/guides/managed-it-support-cost-australia/" class="text-gray-300 hover:text-[#2978F2] transition-colors">IT Support Costs</a></li>
          <li><a href="/guides/essential-eight-explained-small-business/" class="text-gray-300 hover:text-[#2978F2] transition-colors">Essential Eight</a></li>
          <li><a href="/guides/small-business-cyber-security-checklist/" class="text-gray-300 hover:text-[#2978F2] transition-colors">Cyber Security Checklist</a></li>
          <li><a href="/guides/small-business-website-cost-australia/" class="text-gray-300 hover:text-[#2978F2] transition-colors">Website Costs</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-xl font-semibold mb-6">Contact Info</h4>
        <div class="space-y-4">
          <div class="flex items-center space-x-3">
            <Phone className="h-5 w-5 text-[#2978F2]" />
            <a href="tel:+61485000516" class="text-gray-300 hover:underline">
              +61 485 000 516
            </a>
          </div>
          <div class="flex items-center space-x-3">
            <Mail className="h-5 w-5 text-[#2978F2]" />
            <a href="mailto:info@bigbytetech.com.au" class="text-gray-300 hover:underline">
              info@bigbytetech.com.au
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-700 pt-8 flex flex-col md:flex-row justify-between items-center">
      <p class="text-gray-400 text-sm">
        © {year} BigByte Tech. All rights reserved.
      </p>
      <div class="flex space-x-6 mt-4 md:mt-0">
        <a href="#" class="text-gray-400 hover:text-[#2978F2] text-sm transition-colors">Privacy Policy</a>
        <a href="#" class="text-gray-400 hover:text-[#2978F2] text-sm transition-colors">Terms of Service</a>
        <a href="#" class="text-gray-400 hover:text-[#2978F2] text-sm transition-colors">Cookie Policy</a>
      </div>
    </div>
  </div>
</footer>
