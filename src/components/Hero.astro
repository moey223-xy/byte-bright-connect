---
import { ArrowRight, Play } from "lucide-react";
---

<section
  class="relative min-h-screen flex items-center justify-center bg-gradient-to-br from-white via-blue-50/30 to-white overflow-hidden"
>
  <!-- Animated Background -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-20 left-20 w-72 h-72 bg-[#2978F2] rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-20 right-20 w-96 h-96 bg-[#2978F2] rounded-full blur-3xl animate-pulse delay-1000"></div>
  </div>

  <div class="container mx-auto px-6 text-center relative z-10 pt-20">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-5xl md:text-7xl font-bold text-[#1F1F1F] mb-6 leading-tight">
        IT Peace of Mind for{" "}
        <span class="text-[#2978F2] relative">
          Small Businesses
          <span class="absolute -bottom-2 left-0 right-0 h-1 bg-[#2978F2] rounded-full opacity-30"></span>
        </span>
      </h1>

      <p class="text-xl md:text-2xl text-gray-600 mb-12 max-w-3xl mx-auto leading-relaxed">
        Managed support, rock-solid security, and cloud expertise—so you can focus on growth.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
        <a
          href="#contact"
          class="inline-flex items-center justify-center bg-[#2978F2] hover:bg-[#1F5FD4] text-white px-8 py-4 rounded-2xl text-lg font-semibold transition-all duration-300 hover:scale-105 hover:shadow-xl group"
        >
          Get Your Free Consultation
          <ArrowRight className="ml-2 h-5 w-5 group-hover:translate-x-1 transition-transform" />
        </a>
        <a
          href="#services"
          class="inline-flex items-center justify-center border-2 border-[#2978F2] text-[#2978F2] hover:bg-[#2978F2] hover:text-white px-8 py-4 rounded-2xl text-lg font-semibold transition-all duration-300 hover:scale-105 group"
        >
          <Play className="mr-2 h-5 w-5" />
          See Our Services
        </a>
      </div>

      <!-- Trust Indicators -->
      <div class="grid grid-cols-2 gap-8 max-w-xl mx-auto text-center">
        <div class="animate-fade-in" style="animation-delay: 0.2s">
          <div class="text-3xl font-bold text-[#2978F2]">24/7</div>
          <div class="text-gray-600">Support</div>
        </div>
        <div class="animate-fade-in" style="animation-delay: 0.4s">
          <div class="text-3xl font-bold text-[#2978F2]">99.9%</div>
          <div class="text-gray-600">Uptime</div>
        </div>
      </div>
    </div>
  </div>
</section>
