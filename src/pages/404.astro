---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Page Not Found - BigByte Tech"
  description="The page you are looking for could not be found."
>
  <div class="min-h-screen bg-white flex flex-col">
    <Navigation />
    <main class="flex-grow flex items-center justify-center py-32">
      <div class="text-center px-6">
        <h1 class="text-7xl font-bold text-[#2978F2] mb-4">404</h1>
        <p class="text-xl text-gray-600 mb-8">
          Oops! The page you're looking for doesn't exist.
        </p>
        <a
          href="/"
          class="inline-flex items-center justify-center bg-[#2978F2] hover:bg-[#1F5FD4] text-white px-8 py-3 rounded-2xl text-lg font-semibold transition-all duration-300 hover:scale-105 hover:shadow-lg"
        >
          Back to Home
        </a>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
